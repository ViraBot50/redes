!conf Switch acceso
enable 
configure terminal

!parametros basicos
hostname SWA-II-F2-01
ip domain-name equipo5.edu
banner motd #Acceso restringido#
enable secret class
service password-encryption

!console 
line console 0
password cisco
login 
exit

!ssh
username admin secret cisco
crypto key generate rsa
1024
ip ssh version 2
line vty 0 15
login local
transport input ssh
exit

!vlans
!vlan 22
!name Camaras_II
!vlan 23
!name Jefatura_II
!vlan 24
!name Administrativos_II
!vlan 99
!name Admin_TI
!exit

!puertos etherchannel 
interface range g0/1-2
channel-group 3 mode active
interface p3
switchport mode trunk
exit


! Puertos troncales fisicos
interface range g0/1-2
switchport mode trunk
exit

! spanningTree
spanning-tree mode rapid-pvst
interface range f0/1-24
spanning-tree portfast
spanning-tree bpduguard enable
exit



! vtp
vtp version 2
vtp domain Ingenieria-Industrial
vtp password cisco
vtp mode client

!Asignar puertos de acceso
interface range f0/1-8
switchport mode access
switchport access vlan 22

interface range f0/9-16
switchport mode access
switchport access vlan 23

interface range f0/17-24
switchport mode access
switchport access vlan 24



!SVI de administracion
interface vlan 99
ip address 172.30.36.143 255.255.255.128
no shutdown
exit
ip default-gateway 172.30.36.254
end
!Guardar configuracion
copy running-config startup-config
