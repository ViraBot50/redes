!conf Switch de distribucion
enable 
configure terminal

!parametros basicos
hostname SWD-AE-F2-01
ip domain-name equipo5.edu
banner motd #Acceso restringido#
enable secret class
service password-encryption

!console 
line console 0
password cisco
login 
exit

!ssh
username admin secret cisco
crypto key generate rsa
1024
ip ssh version 2
line vty 0 15
login local
transport input ssh
exit



!Asignar puertos de acceso (N/A)

!puertos troncales
!Configurar EtherChannel
!Conexion a Switch Core
interface range G1/0/1-2
channel-group 5 mode active
interface p5
switchport mode trunk
!Conexion a SWA-AE-F1-01
interface range G1/0/11-12
channel-group 11 mode active
interface p11
switchport mode trunk
!Conexion a SWA-AE-F1-02
interface range G1/0/13-14
channel-group 12 mode active
interface p12
switchport mode trunk
!Conexion a SWA-AE-F2-01
interface range G1/0/15-16
channel-group 13 mode active
interface p13
switchport mode trunk
!Conexion a SWA-AE-F2-02
interface range G1/0/17-18
channel-group 14 mode active
interface p14
switchport mode trunk
exit


! Puertos troncales fisicos
interface range g1/0/1-2
switchport mode trunk
exit

interface range g1/0/11-18
switchport mode trunk
exit

! spanningTree
spanning-tree mode rapid-pvst
spanning-tree vlan 11-14,99 root secondary

! vtp
vtp version 2
vtp domain Administracion-empresarial
vtp password cisco
vtp mode server

!vlans
vlan 11
name Laboratorios_AE
vlan 12
name Camaras_AE
vlan 13
name Jefatura_AE
vlan 14
name Administrativos_AE
vlan 99
name Admin_TI
exit


!SVI de administracion
interface vlan 99
ip address 172.30.36.140 255.255.255.128
no shutdown
exit
ip default-gateway 172.30.36.254

end
copy running-config startup-config