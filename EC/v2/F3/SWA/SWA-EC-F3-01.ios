!conf Switch acceso
enable 
configure terminal

!parametros basicos
hostname SWA-EC-F3-01
ip domain-name equipo5.edu
banner motd #Acceso restringido#
enable secret class
service password-encryption

!console 
line console 0
password cisco
login 
exit

!ssh
username admin secret cisco
crypto key generate rsa
1024
ip ssh version 2
line vty 0 15
login local
transport input ssh
exit

!vlans
! vlan 3
! name Administrativos
! vlan 4
! name Directivos
! vlan 7
! name Servidores
! vlan 99
! name Admin_TI
! exit

!Asignar puertos de acceso
interface range f0/1-8
switchport mode access
switchport access vlan 3

interface range f0/9-16
switchport mode access
switchport access vlan 4

interface range f0/17-24
switchport mode access
switchport access vlan 7

! Puertos EtherChannel
interface range g0/1-2
channel-group 5 mode active
interface p5
switchport mode trunk
exit


!Spanning-tree
Spanning-tree mode rapid-pvst
interface range f0/1-24
Spanning-tree portfast
Spanning-tree bpduguard enable 
exit

!SVI de administracion
interface vlan 99
ip address 172.30.36.133 255.255.255.128
no shutdown
exit
ip default-gateway 172.30.36.254
end
!Guardar configuracion
copy running-config startup-config
