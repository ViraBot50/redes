!conf Switch acceso
enable 
configure terminal

!parametros basicos
hostname SWA-EC-F1-02
ip domain-name equipo5.edu
banner motd #Acceso restringido#
enable secret class
service password-encryption

!console 
line console 0
password cisco
login 
exit

!ssh
username admin secret cisco
crypto key generate rsa
1024
ip ssh version 2
line vty 0 15
login local
transport input ssh
exit

!vlans
! vlan 6
! name Estudiantes
! vlan 99
! name Admin_TI
! exit


!Asignar puertos de acceso
interface range f0/1-24
switchport mode access
switchport access vlan 6

!puertos etherchannel
interface range g0/1-2
channel-group 2 mode active
interface p2
switchport mode trunk
exit


!SVI de administracion
interface vlan 99
ip address 172.30.36.130 255.255.255.128
no shutdown
exit
ip default-gateway 172.30.36.254
end
!Guardar configuracion
copy running-config startup-config
