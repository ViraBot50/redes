!conf Switch de distribucion
enable 
configure terminal

!parametros basicos
hostname SWD-BB-F2-01
ip domain-name equipo5.edu
banner motd #Acceso restringido#
enable secret class
service password-encryption

!console 
line console 0
password cisco
login 
exit

!ssh
username admin secret cisco
crypto key generate rsa
1024
ip ssh version 2
line vty 0 15
login local
transport input ssh
exit

!vlans
!vlan 41
!name Salas_Lectura_BB
!vlan 42
!name Camaras_BB
!vlan 43
!name Jefatura_BB
!vlan 44
!name Control_BB
!vlan 99
!name Admin_TI
!exit

!Asignar puertos de acceso (N/A)
!Configurar EtherChannel
!Conexion a Switch Core
interface range G1/0/1-2
channel-group 4 mode active
interface p4
switchport mode trunk
!Conexion a SWA-BB-F1-01
interface range G1/0/11-12
channel-group 41 mode active
interface p41
switchport mode trunk
!Conexion a SWA-BB-F1-02
interface range G1/0/13-14
channel-group 42 mode active
interface p42
switchport mode trunk
!Conexion a SWA-BB-F2-01
interface range G1/0/15-16
channel-group 43 mode active
interface p43
switchport mode trunk
!Conexion a SWA-BB-F2-02
interface range G1/0/17-18
channel-group 44 mode active
interface p44
switchport mode trunk
exit

!SVI de administracion
interface vlan 99
ip address 172.30.36.155 255.255.255.128
no shutdown
exit
ip default-gateway 172.30.36.254
exit

!Guardar configuracion
copy running-config startup-config

