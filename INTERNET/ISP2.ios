!conf router ISP2
enable 
configure terminal

!parametros basicos
hostname ISP2
ip domain-name equipo5.edu
banner motd #Acceso restringido#
enable secret class
service password-encryption

!console 
line console 0
password cisco
login 
exit

!ssh
username admin secret cisco
crypto key generate rsa
1024
ip ssh version 2
line vty 0 4
login local
transport input ssh
exit

! Enlace a ISP1
int S0/2/0
ip address 209.165.201.46 255.255.255.240
description Enlace a ISP1
no shutdown 

!gateway de red de ISP2
int G0/0/0
ip address 209.165.201.30 255.255.255.240
description gateway de red de ISP2
no shutdown 

! Enlace a R-EXT-EDGE
int S0/1/1
ip address 209.165.200.222 255.255.255.224
description Enlace a R-EXT-EDGE
no shutdown 

!Configuracion routeo estatico
ip route 0.0.0.0 0.0.0.0 209.165.201.33
ip route 209.165.202.128 255.255.255.252 209.165.200.193

