!conf Switch de distribucion
enable 
configure terminal

!parametros basicos
hostname SWD-AE-F2-01
ip domain-name equipo5.edu
banner motd #Acceso restringido#
enable secret class
service password-encryption

!console 
line console 0
password cisco
login 
exit

!ssh
username admin secret cisco
crypto key generate rsa
1024
ip ssh version 2
line vty 0 15
login local
transport input ssh
exit

!vlans
vlan 11
name Laboratorios_AE
vlan 12
name Camaras_AE
vlan 13
name Jefatura_AE
vlan 14
name Administrativos_AE
vlan 99
name Admin_TI
exit

!Asignar puertos de acceso (N/A)

!puertos troncales
interface range g1/0/1-5
switchport mode trunk
exit

!SVI de administracion
interface vlan 99
ip address 172.30.36.140 255.255.255.128
no shutdown
exit
ip default-gateway 172.30.36.254

