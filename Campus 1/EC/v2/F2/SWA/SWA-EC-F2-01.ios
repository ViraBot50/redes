!conf Switch acceso
enable 
configure terminal

!parametros basicos
hostname SWA-EC-F2-01
ip domain-name equipo5.edu
banner motd #Acceso restringido#
enable secret class
service password-encryption

!console 
line console 0
password cisco
login 
exit

!ssh
username admin secret cisco
crypto key generate rsa
1024
ip ssh version 2
line vty 0 15
login local
transport input ssh
exit

!vlans
! vlan 5
! name Soporte_TI
! vlan 8
! name Profesores
! vlan 99
! name Admin_TI
! exit
! Puertos EtherChannel
interface range g0/1-2
channel-group 3 mode active
interface p3
switchport mode trunk
exit

! Puertos troncales fisicos
interface range g0/1-2
switchport mode trunk
exit


! spanningTree
spanning-tree mode rapid-pvst
interface range f0/1-24
spanning-tree portfast
spanning-tree bpduguard enable
exit

! vtp
vtp version 2
vtp domain Edificio-Central
vtp password cisco
vtp mode client
!
!Asignar puertos de acceso
interface range f0/1-12
switchport mode access
switchport access vlan 5

interface range f0/13-24
switchport mode access
switchport access vlan 8
 


!SVI de administracion
interface vlan 99
ip address 172.30.36.131 255.255.255.128
no shutdown
exit
ip default-gateway 172.30.36.254
end
!Guardar configuracion
copy running-config startup-config
