!conf router edge ec
enable 
configure terminal

!parametros basicos
hostname R-EC-EDGE
ip domain-name equipo5.edu
banner motd #Acceso restringido#
enable secret class
service password-encryption

!console 
line console 0
password cisco
login 
exit

!ssh
username admin secret cisco
crypto key generate rsa
1024
ip ssh version 2
line vty 0 15
login local
transport input ssh
exit

!configuracion a enlace ISP1
int g0/0/1
description Enlace a ISP1
ip address 209.165.200.254 255.255.255.224
no shutdown 

!configuracion a enlace core campus 1
int g0/0/0
description Enlace a core campus 1
ip address 172.30.51.22 255.255.255.252
no shutdown 

!Configuracion ruta default a ISP1
ip route 0.0.0.0 0.0.0.0 209.165.200.225

!Tunnel con R-EXT-EDGE
int tunnel 0
ip address 10.10.10.10 255.255.255.252
tunnel source G0/0/1
tunnel destination 209.165.200.193
tunnel mode gre ip 
no shutdown 

!Configuracion de OSPF
router ospf 5 
router-id 1.1.1.0
auto-cost reference-bandwidth 1000
network 172.30.51.20 0.0.0.3 area 0
network 10.10.10.8 0.0.0.3 area 0
default-information originate 
end

!Configuracion de nat
int g0/0/0
ip nat inside 
int g0/0/1
ip nat outside 
exit

ip access-list standard RED-CAMPUS-1-2 
permit 172.30.0.0 0.0.255.255
deny any 
exit

ip nat pool CAMPUS-POOL-1-2 209.165.202.133 209.165.202.133 netmask 255.255.255.252
ip nat inside source list RED-CAMPUS-1-2 pool CAMPUS-POOL-1-2 overload



